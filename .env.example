# Salin ke `.env` lalu isi. `.env` tidak pernah masuk repo; jangan tempel nilai rahasia di chat.

# --- Umum -------------------------------------------------------------------
# Level log: debug | info | warn | error | silent
LOG_LEVEL=info

# Lokasi berkas SQLite (relatif terhadap folder app/). Folder dibuat otomatis.
DATABASE_PATH=data/piard.db

# Lama sesi login (hari).
SESSION_TTL_DAYS=30

# --- AI ---------------------------------------------------------------------
# mock       : keluaran palsu deterministik, tanpa jaringan dan tanpa biaya (dev, tes, e2e)
# openrouter : panggilan nyata (OpenRouter dan/atau Anthropic); wajib mengisi SEMUA MODEL_* dan kunci penyedianya
LLM_MODE=mock

# Kunci dari https://openrouter.ai/keys. Hanya dibaca bila LLM_MODE=openrouter.
OPENROUTER_API_KEY=

# Kunci dari https://console.anthropic.com/settings/keys. Wajib hanya bila ada MODEL_* berawalan
# "claude-" (ID API Anthropic, mis. claude-haiku-5-5): model itu dipanggil langsung ke Anthropic,
# bukan lewat OpenRouter. ID gaya OpenRouter ("anthropic/claude-haiku-5.5") tetap lewat OpenRouter.
ANTHROPIC_API_KEY=

# ID model per tugas: "vendor/nama-model" (OpenRouter) atau "claude-..." (langsung ke Anthropic). Hasil uji
# tiap model ada di docs/ai-pipeline.md. Boleh kosong di mode mock. Halaman Pengaturan (/settings) bisa
# menimpa nilai ini tanpa mulai ulang server.
MODEL_QUESTIONS=anthropic/claude-haiku-5.5
MODEL_ROADMAP=anthropic/claude-haiku-5.5
MODEL_PRD=
MODEL_SPEC=
MODEL_TASKS=
MODEL_CHAT=
# Analisis proyek eksisting (ZIP/GitHub). Boleh kosong: bawaan claude-haiku-5-5 bila ANTHROPIC_API_KEY
# terisi, selain itu anthropic/claude-haiku-5.5 lewat OpenRouter.
MODEL_CODEBASE=

# --- Batas biaya (USD, opsional; kosong = tanpa batas) -----------------------
# Untuk seluruh aplikasi. Saat tercapai, job AI baru, chat, dan pertanyaan ditolak (BUDGET_EXCEEDED).
# Halaman Pengaturan (/settings) bisa menimpa nilai ini.
BUDGET_DAILY_USD=
BUDGET_MONTHLY_USD=

# --- Proyek eksisting (ADR 0016) ---------------------------------------------
# Batas ukuran upload ZIP dalam MB (1-500, bawaan 50). Sumber sementara disimpan di
# <folder database>/tmp/codebase dan dihapus setelah analisis atau 24 jam.
CODEBASE_MAX_UPLOAD_MB=
# Alamat publik Piard yang dipakai di prompt agen (mis. https://piard.example.com). Kosong = alamat
# yang sedang dibuka di browser. Agen di mesin yang sama cukup memakai http://localhost:3000.
APP_URL=
