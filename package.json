{
  "name": "piard",
  "version": "0.1.0",
  "private": true,
  "description": "Piard: ubah ide menjadi PRD, roadmap, spesifikasi, dan task siap tempel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen > /dev/null && tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "deps": "depcruise src mcp --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm deps && pnpm test",
    "check:fast": "pnpm typecheck && pnpm lint",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "docs:api": "tsx --require ./scripts/stub-server-only.cjs --require ./scripts/ignore-css.cjs scripts/gen-api-docs.ts",
    "llm:check": "tsx --require ./scripts/stub-server-only.cjs --env-file=.env scripts/llm-check.ts",
    "eval:roadmap": "tsx --require ./scripts/stub-server-only.cjs --env-file=.env evals/roadmap.eval.ts",
    "eval:prd": "tsx --require ./scripts/stub-server-only.cjs --env-file=.env evals/prd.eval.ts",
    "eval:build": "tsx --require ./scripts/stub-server-only.cjs --env-file=.env evals/build.eval.ts",
    "eval:chat": "tsx --require ./scripts/stub-server-only.cjs --env-file=.env evals/chat.eval.ts",
    "eval:codebase": "tsx --require ./scripts/stub-server-only.cjs --env-file=.env evals/codebase.eval.ts",
    "mcp": "node mcp/server.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check:fast"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@xyflow/react": "^12.12.0",
    "ai": "^7.0.155",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "geist": "^1.8.2",
    "lucide-react": "^1.62.0",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^18.7.0",
    "drizzle-kit": "^0.31.11",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
